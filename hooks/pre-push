#!/bin/bash
# ==============================================================================
# hooks/pre-push - pre-push フック本体
# ==============================================================================
# sf-hook.sh が、このファイル（~/sf-tools/hooks/pre-push）を、プロジェクトの .git/hooks/pre-push にコピーして使う
# （実行権限を付けて、上書き）。sf-unhook.sh は、下の目印の行があるときだけ、.git/hooks/pre-push を削除する。
# $HOME/sf-tools/bin/sf-prepush.sh --verbose を実行し、その終了コードを返す（0 以外ならプッシュ中止）。
#   git がフックに渡す引数（リモート名・URL）は、渡さない。標準入力（push する参照の一覧）は、そのまま引き継ぐ
#   （sf-prepush.sh が読む）。lib/common.sh は読み込まないため、run は使わない。
# sf-prepush.sh が見つからない（通常のファイルとして存在しない）ときは、標準エラーに
# 「[PRE-PUSH][ERROR] スクリプトが見つかりません: パス」を表示して、終了コード 1 を返す（プッシュ中止）。
# ==============================================================================

# Generated by sf-tools: wrapper for pre-push hook

readonly SCRIPT_PATH="$HOME/sf-tools/bin/sf-prepush.sh"

if [[ ! -f "$SCRIPT_PATH" ]]; then
    echo "[PRE-PUSH][ERROR] スクリプトが見つかりません: $SCRIPT_PATH" >&2
    exit 1
fi

"$SCRIPT_PATH" --verbose
exit $?
