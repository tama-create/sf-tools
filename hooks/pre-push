#!/bin/bash
# ==============================================================================
# hooks/pre-push - pre-push フック本体
# ==============================================================================
# sf-hook.sh が、このファイル（~/sf-tools/hooks/pre-push）を、プロジェクトの .git/hooks/pre-push にコピーして使う。
# $HOME/sf-tools/bin/sf-prepush.sh --verbose を実行し、その終了コードを返す（0 以外ならプッシュ中止）。
# sf-prepush.sh が見つからないときは、エラーを表示して、終了コード 1 を返す（プッシュ中止）。
# ==============================================================================

# Generated by sf-tools: wrapper for pre-push hook

readonly SCRIPT_PATH="$HOME/sf-tools/bin/sf-prepush.sh"

if [[ ! -f "$SCRIPT_PATH" ]]; then
    echo "[PRE-PUSH][ERROR] スクリプトが見つかりません: $SCRIPT_PATH" >&2
    exit 1
fi

"$SCRIPT_PATH" --verbose
exit $?
