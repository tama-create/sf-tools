#!/bin/bash

# ==============================================================================
# hooks/pre-commit - pre-commit フック本体
# ==============================================================================
# sf-hook.sh が、このファイル（~/sf-tools/hooks/pre-commit）を、プロジェクトの .git/hooks/pre-commit にコピーして使う
# （実行権限を付けて、上書き）。sf-unhook.sh は、pre-commit を削除しない（pre-push だけを削除する）。
# $HOME/sf-tools/bin/sf-precommit.sh --verbose を実行し、その終了コードを返す（0 以外ならコミット中止）。
#   lib/common.sh は読み込まないため、run は使わない。
# sf-precommit.sh が見つからない（通常のファイルとして存在しない）ときは、標準エラーに
# 「[PRE-COMMIT][ERROR] スクリプトが見つかりません: パス」を表示して、終了コード 1 を返す（コミット中止）。
# 下の目印の行は、pre-push 用と同じ文言（lib/common.sh の SF_HOOK_MARKER）のまま。pre-commit では、照合に使われていない
# （sf-unhook.sh が照合するのは .git/hooks/pre-push だけ）。
# ==============================================================================

# Generated by sf-tools: wrapper for pre-push hook

readonly SCRIPT_PATH="$HOME/sf-tools/bin/sf-precommit.sh"

if [[ ! -f "$SCRIPT_PATH" ]]; then
    echo "[PRE-COMMIT][ERROR] スクリプトが見つかりません: $SCRIPT_PATH" >&2
    exit 1
fi

"$SCRIPT_PATH" --verbose
exit $?
