#!/bin/bash

# ==============================================================================
# hooks/pre-commit - pre-commit フック本体
# ==============================================================================
# sf-hook.sh が、このファイル（~/sf-tools/hooks/pre-commit）を、プロジェクトの .git/hooks/pre-commit にコピーして使う。
# $HOME/sf-tools/bin/sf-precommit.sh --verbose を実行し、その終了コードを返す（0 以外ならコミット中止）。
# sf-precommit.sh が見つからないときは、エラーを表示して、終了コード 1 を返す（コミット中止）。
# ==============================================================================

# Generated by sf-tools: wrapper for pre-push hook

readonly SCRIPT_PATH="$HOME/sf-tools/bin/sf-precommit.sh"

if [[ ! -f "$SCRIPT_PATH" ]]; then
    echo "[PRE-COMMIT][ERROR] スクリプトが見つかりません: $SCRIPT_PATH" >&2
    exit 1
fi

"$SCRIPT_PATH" --verbose
exit $?
