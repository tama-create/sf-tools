# ==============================================================================
# fixture.example.env - e2e テストの鍵一式の雛形（見本）
# ==============================================================================
# 本物は ~/.sf-tools-e2e/fixture.env に置く（リポジトリの外。tests/e2e/bootstrap.sh が対話で作成する）。
# このファイルには、本物の値を書かないこと。
# ==============================================================================
E2E_OWNER=tamashimon-org                 # テスト用リポジトリのオーナー（組織名）
E2E_GH_USER=tamashimon                   # e2e を実行する gh のログインユーザー（組織の管理者）
E2E_HOME_ROOT=/c/home                    # 作業フォルダの root（{root}/{owner}/{project}。/home で終わること）
E2E_PAT_TOKEN=ghp_xxxxxxxxxxxxxxxx       # Classic PAT（repo・workflow）
E2E_SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx    # Slack の Bot Token
E2E_SLACK_CHANNEL_ID=C0XXXXXXXXX         # 通知先の共有チャンネルの ID（Bot を招待済み）
E2E_SFDX_AUTH_URL=force://PlatformCLI::xxxx@xxxx.my.salesforce.com   # テスト用組織の認証 URL
