#!/bin/bash
# ==============================================================================
# sf（差し替え用）- e2e テストで PATH の先頭に置く
# ==============================================================================
# sf-init が呼ぶ「sf org login web」だけを、認証 URL でのログイン（sf org login sfdx-url）に置き換える。
# （ブラウザでのログインを自動化するため。ログイン後の deploy / retrieve / JWT ログインは本物の sf が動く）
# それ以外のコマンドは、本物の sf にそのまま渡す。
#
# 環境変数（run.sh が設定する）:
#   E2E_SHIM_DIR           この差し替えを置いたフォルダ（本物の sf を探すときに PATH から除く）
#   E2E_SFDX_URL_FILE      main の組織の認証 URL を書いたファイル（値は環境変数に載せない）
#   E2E_SFDX_URL_FILE_STG  staging の組織の認証 URL を書いたファイル（2 層・3 層のとき）
#   E2E_SFDX_URL_FILE_DEV  develop の組織の認証 URL を書いたファイル（3 層のとき）
#   E2E_SHIM_LOGIN_TRIES / E2E_SHIM_LOGIN_WAIT  ログインの試行回数（既定 3）と、やり直すまでの待ち（秒。既定 5）
#
# どの組織にログインするかは、--alias の末尾で決める（sf-init が、段階ごとに sf-tools-PROD / sf-tools-STG / sf-tools-DEV を付ける）:
#   末尾が STG → staging の組織 / 末尾が DEV → develop の組織 / それ以外 → main の組織
# ==============================================================================
_real_sf=$(PATH="${PATH//${E2E_SHIM_DIR}:/}" command -v sf)
[[ -n "$_real_sf" ]] || { echo "sf shim: 本物の sf が見つかりません" >&2; exit 127; }

if [[ "$1" == "org" && "$2" == "login" && "$3" == "web" ]]; then
    _alias=""
    _prev=""
    for _a in "$@"; do
        [[ "$_prev" == "--alias" || "$_prev" == "-a" ]] && _alias="$_a"
        _prev="$_a"
    done
    _urlfile="${E2E_SFDX_URL_FILE:-}"
    case "$_alias" in
        *STG) _urlfile="${E2E_SFDX_URL_FILE_STG:-}" ;;
        *DEV) _urlfile="${E2E_SFDX_URL_FILE_DEV:-}" ;;
    esac
    [[ -f "$_urlfile" ]] || { echo "sf shim: 認証 URL のファイルがありません（alias=${_alias:-なし}）" >&2; exit 1; }
    # 一時的な失敗（Salesforce 側の応答の乱れ。理由が空の RefreshTokenAuthError など）に備え、待って、やり直す（e2e だけの差し替え）
    _tries="${E2E_SHIM_LOGIN_TRIES:-3}"
    _wait="${E2E_SHIM_LOGIN_WAIT:-5}"
    _rc=1
    for ((_i = 1; _i <= _tries; _i++)); do
        "$_real_sf" org login sfdx-url --sfdx-url-file "$_urlfile" ${_alias:+--alias "$_alias"} && exit 0
        _rc=$?
        if (( _i < _tries )); then
            echo "sf shim: 認証 URL でのログインに失敗しました（${_i}/${_tries}）。${_wait} 秒待って、やり直します。" >&2
            sleep "$_wait"
        fi
    done
    exit $_rc
fi

exec "$_real_sf" "$@"
