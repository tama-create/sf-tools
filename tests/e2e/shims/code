#!/bin/bash
# ==============================================================================
# code（差し替え）- e2e テストで PATH の先頭に置く
# ==============================================================================
# sf-start.sh の「code .」と、sf-push.sh の「code --new-window --wait <ファイル>」の代わりに、
# VS Code を開かない。
#   ・--wait とファイルが渡されたとき（sf-push.sh のコミットメッセージ入力）: メッセージを書き込んで終わる
#     （開発者が、VS Code でメッセージを入力して閉じる操作の代わり）
#   ・それ以外（code .）: 何もしない
#
# 環境変数（run.sh が設定する）:
#   E2E_COMMIT_MSG  書き込むコミットメッセージ（既定: e2e）
# ==============================================================================
_last=""
_wait=0
for _a in "$@"; do
    [[ "$_a" == "--wait" || "$_a" == "-w" ]] && _wait=1
    _last="$_a"
done
if [[ $_wait -eq 1 && -f "$_last" ]]; then
    printf '%s\n' "${E2E_COMMIT_MSG:-e2e}" > "$_last"
fi
exit 0
